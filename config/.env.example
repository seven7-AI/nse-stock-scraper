# Supabase-only backend
DB_BACKEND=supabase

# Main stock table
STOCK_TABLE=stock_data

# Supabase settings
# Use your project's PostgREST URL and service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_TABLE=stock_data
# StockAnalysis scraper table (one row per stock, all tabs in JSONB columns)
STOCKANALYSIS_TABLE=stockanalysis_stocks

# Optional
LOG_LEVEL=INFO
