# Select a backend: sqlite (default) | supabase
DB_BACKEND=sqlite

# Main stock table (afx_scraper)
STOCK_TABLE=stock_data
# StockAnalysis scraper table (one row per stock, all tabs in JSON columns)
STOCKANALYSIS_TABLE=stockanalysis_stocks

# --- SQLite (default backend) -------------------------------------------------
# Relative paths resolve against the working directory: the repo root locally, /app in
# the container. Must sit inside the ../data volume that docker-compose mounts, or the
# database is discarded when the one-shot container is removed.
SQLITE_DB_PATH=data/nse_scraper.sqlite3

# --- Supabase (alternate backend, used when DB_BACKEND=supabase) ---------------
# Use your project's PostgREST URL and service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_TABLE=stock_data

# Optional
LOG_LEVEL=INFO
