# Copy this file to .env and fill in actual values.
DB_BACKEND=sqlite
STOCK_TABLE=stock_data
STOCKANALYSIS_TABLE=stockanalysis_stocks

# SQLite path inside the container. deployment/docker-compose.yml mounts ../data here and
# also sets this variable, so the database persists across `docker compose run --rm`.
SQLITE_DB_PATH=/app/data/nse_scraper.sqlite3

# Supabase settings, used only when DB_BACKEND=supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=stock_data

# Optional
LOG_LEVEL=INFO
